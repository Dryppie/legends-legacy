{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  },
  "Chat": {
    "SystemMessages": {
      "BaseUrl": "https://localhost:7095/chat",
      "Secret": "local-development-system-chat-secret",
      "TimeoutSeconds": 2
    }
  },
  "Debug": {
    "Tutorial": {
      "Enabled": true
    }
  },
  "DungeonPowerCalibration": {
    "Enabled": true
  }
}
