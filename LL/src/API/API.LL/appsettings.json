{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "FeatureManagement": {
    "AllowAnonymous": true
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LegendsLegacyDB": "Server=(localdb)\\MSSQLLocalDB;Database=LegendsLegacy;Trusted_Connection=True;MultipleActiveResultSets=true",
    "ProviderName": "System.Data.SqlClient"
  },
  "Database": {
    "TimeoutInSeconds": 30,
    "Type": "SqlServer", // or "MariaDb"
    "ConnectionStrings": {
      "LegendsLegacyDB": "Server=(localdb)\\MSSQLLocalDB;Database=LegendsLegacy;Trusted_Connection=True;MultipleActiveResultSets=true"
    }
  },
  "Jwt": {
    "AccessTokenSecretKey": "PleaseDoUseAnOddlyLongPrivateKeySoThatItCreatesANiceTokenOrElse!V1",
    "RefreshTokenSecretKeyV2": "PleaseDoUseAnOddlyLongPrivateKeySoThatItCreatesANiceTokenOrElse!V2",
    "Issuer": "", // "https://smth.dk", commented
    "Audience": "", // "https://smth.dk", commented
    "AccessTokenExpiryDurationMinutes": 240, // 4 hours
    "RefreshTokenExpiryDurationMinutes": 43800 // 1 month
  },
  "Quartz": {
    "quartz.dataSource.default.connectionString": "Data Source=.;Initial Catalog=LL.Quartz;Integrated Security=True;TrustServerCertificate=True;",
    "quartz.scheduler.instanceName": "Scheduler",
    "quartz.scheduler.instanceId": "AUTO",
    "quartz.serializer.type": "json"
  },
  "Jobs": {
    "DailyResetJob ": {
      "Schedule": "0 0 12 * * ?"
    }
  },
  "SwaggerOptions": {
    "AutoAuthorize": true,
    "UserEmail": "admin@hotmail.com"
  }
}