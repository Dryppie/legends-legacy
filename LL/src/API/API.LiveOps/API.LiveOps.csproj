<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediatR" Version="14.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.5" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Application\Application.csproj" />
    <ProjectReference Include="..\..\Core\Common\Common.csproj" />
    <ProjectReference Include="..\..\Core\Domain\Domain.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Persistence\Persistence.LL\Persistence.LL.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Service\Services.LL\Services.LL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\API.LL\Data\essences\essences.json">
      <Link>Data\essences\essences.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\API.LL\Data\combat\abilities.json">
      <Link>Data\combat\abilities.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <LiveOpsUiDist>$(MSBuildProjectDirectory)\..\..\Presentation\liveops\dist\liveops\browser</LiveOpsUiDist>
  </PropertyGroup>

  <Target Name="CopyLiveOpsUiForPublish" AfterTargets="ComputeFilesToPublish" Condition="Exists('$(LiveOpsUiDist)')">
    <ItemGroup>
      <LiveOpsUiFiles Include="$(LiveOpsUiDist)\**\*" />
      <ResolvedFileToPublish Include="@(LiveOpsUiFiles)" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
