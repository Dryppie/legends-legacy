{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Quartz": "Information"
    }
  },
  "Content": {
    "Root": "Data"
  },
  "ConnectionStrings": {
    "LegendsLegacyDB": ""
  },
  "Database": {
    "TimeoutInSeconds": 30
  },
  "BackgroundJobs": {
    "MaxConcurrency": 5,
    "RunningExecutionTimeoutMinutes": 30,
    "SmokeJob": {
      "Enabled": false
    }
  }
}
