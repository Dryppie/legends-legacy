    "autoprefixer": "^10.4.20",
    "fs-extra": "^11.3.0",
    "globby": "^14.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.41",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "sharp": "^0.34.2",
    "tailwindcss": "^3.4.10",
    "ts-node": "^10.9.2",
