{
  "name": "ll",
  "version": "0.0.0",
  "packageManager": "npm@10.9.2",
  "scripts": {
    "generate:version": "tsx ./scripts/write-build-version.ts",
    "generate:state-sync-scopes": "tsx ./scripts/generate-state-sync-scopes.ts",
    "validate:guides": "tsx ./scripts/validate-guides.ts",
    "ng": "ng",
    "start": "ng serve --open",
    "build": "npm run generate:state-sync-scopes && npm run generate:version && npm run validate:guides && ng build",
    "build:development": "npm run generate:state-sync-scopes && npm run validate:guides && ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "npm run generate:state-sync-scopes && ng test --watch=false --browsers=ChromeHeadless"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.27",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.27",
    "@angular/compiler": "^20.3.27",
    "@angular/core": "^20.3.27",
    "@angular/forms": "^20.3.27",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.27",
    "@angular/platform-browser-dynamic": "^20.3.27",
    "@angular/router": "^20.3.27",
    "@microsoft/signalr": "^8.0.7",
    "@microsoft/signalr-protocol-msgpack": "^8.0.7",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.32",
    "@angular/cli": "^20.3.32",
    "@angular/compiler-cli": "^20.3.27",
    "@types/fs-extra": "^11.0.4",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.15.18",
    "angular-cli-ghpages": "^2.0.1",
    "autoprefixer": "^10.4.20",
    "fs-extra": "^11.3.0",
    "globby": "^14.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.41",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "sharp": "^0.34.2",
    "tailwindcss": "^3.4.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "~5.9.3"
  }
}
