<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject Condition="'$(QualifiedRuntime)' == ''">BalanceHarness.ProcessFixture.FixtureHost</StartupObject>
    <StartupObject Condition="'$(QualifiedRuntime)' != ''">BalanceHarness.ProcessFixture.PlainMaximumFixtureHost</StartupObject>
  </PropertyGroup>
  <ItemGroup Condition="'$(QualifiedRuntime)' == ''">
    <ProjectReference Include="../../tools/BalanceHarness/BalanceHarness.csproj" />
  </ItemGroup>
  <!-- Compile the test boundary against an already qualified runtime without
       rebuilding or replacing any captured gameplay or harness assembly. -->
  <ItemGroup Condition="'$(QualifiedRuntime)' != ''">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Remove="**/*.cs" />
    <Compile Include="PlainMaximumFixtureHost.cs;ProposalStudyFixtureHost.cs" />
    <Reference Include="$(QualifiedRuntime)/*.dll" />
  </ItemGroup>
</Project>
